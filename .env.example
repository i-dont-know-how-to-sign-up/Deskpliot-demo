# DeskPilot model configuration
#
# This project uses an OpenAI-compatible API interface. You can point it to
# OpenAI, DashScope/Qwen, DeepSeek, Moonshot, local vLLM, or any compatible
# service by changing the base URL and model names.

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_ENABLE_THINKING=false

# Retry only transient model/embedding HTTP failures (429/502/503/504 and connection errors).
LLM_API_MAX_ATTEMPTS=3
LLM_API_RETRY_BASE_SECONDS=0.5

# If true and API keys are empty or requests fail, DeskPilot falls back to a
# local hash embedding and extractive answer so the demo remains runnable.
ALLOW_LOCAL_FALLBACK=true

# Memory vector database.
# auto: use Chroma if chromadb is installed, otherwise use embedded SQLite vector store.
# chroma: require chromadb and persist vectors under data/memory/vectors/chroma.
# sqlite: use the built-in zero-extra-dependency vector store.
MEMORY_VECTOR_PROVIDER=auto

# Web research configuration.
# duckduckgo: no API key required, but stability depends on public HTML access.
# bing: uses Bing Web Search API, put the key in SEARCH_API_KEY or BING_SEARCH_API_KEY.
# tavily: uses Tavily Search API, put the key in SEARCH_API_KEY or TAVILY_API_KEY.
# playwright: uses a local browser to search and read pages, useful for dynamic pages.
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_ENDPOINT=
RESEARCH_MAX_RESULTS=5

# Playwright Search & Browser Reader.
# Effective only when SEARCH_PROVIDER=playwright.
# BROWSER_CHANNEL=chrome reuses local Chrome; chromium uses Playwright Chromium.
# BROWSER_HEADLESS=false is easier to debug; true is quieter for daily use.
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
SEARCH_ENGINE=bing

# Tool permission policy.
# Semicolon-separated safe roots. Empty means: project root + data/workspace.
# Writes outside safe roots, especially C:\ paths, require an in-app approval.
# Code execution and risky shell execution use a one-time approval ID; confirm is not an LLM tool slot.
TOOL_SAFE_ROOTS=
TOOL_COMMAND_TIMEOUT_SECONDS=30
# shell.execute_command 的默认超时；程序强制限制在 1-120 秒。

# Email MCP. Use mock for local tests. For 163/QQ use an authorization code,
# not the normal mailbox password. Outlook commonly requires OAuth/app password.
EMAIL_PROVIDER=mock
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_MAILBOX=INBOX
EMAIL_DRAFTS_MAILBOX=Drafts
EMAIL_SENT_MAILBOX=Sent
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_PORT=465
EMAIL_MOCK_FILE=
# 邮件附件限制：审批前即校验，避免确认后才因文件过大失败。
EMAIL_ATTACHMENT_MAX_MB=20
EMAIL_ATTACHMENTS_TOTAL_MAX_MB=25

# 上下文工程：auto 优先使用本机已有的模型 tokenizer，否则明确降级为 heuristic。
# 可选值：auto / tiktoken / transformers
CONTEXT_TOKENIZER_PROVIDER=auto

# 是否额外调用一次 LLM 改写 RAG 查询；默认关闭以节省延迟和 token。
RAG_QUERY_REWRITE_LLM=false

# RAG P0 自适应分块与句子窗口索引。结构化文档优先按标题/页面/表格分块，
# PDF/TXT 使用 embedding 语义断点；当前不依赖 LangChain/LlamaIndex/LangGraph。
RAG_CHUNKING_POLICY=adaptive
RAG_MIN_CHUNK_TOKENS=160
RAG_CHILD_TOKENS=400
RAG_CHILD_MAX_TOKENS=620
RAG_PARENT_TOKENS=1200
RAG_OVERLAP_SENTENCES=1
RAG_SEMANTIC_BREAKPOINT_PERCENTILE=92
RAG_SEMANTIC_BUFFER_SENTENCES=2
RAG_SENTENCE_WINDOW_SIZE=2
RAG_EMBEDDING_BATCH_SIZE=16

# RAG P1 混合召回与查询扩展。
# hybrid 可独立关闭并回退到 P0；Multi-Query 只在复杂任务触发。
# HyDE 默认关闭，确认目标数据集有收益后再启用。
RAG_HYBRID_ENABLED=true
RAG_MULTI_QUERY_ENABLED=true
RAG_HYDE_ENABLED=false
RAG_RRF_K=60
RAG_DENSE_MIN_SCORE=0.08
RAG_DENSE_PROVIDER=exact

# RAG P2 精排、上下文扩展和最终证据选择。
# lexical 为零依赖默认实现；cross_encoder 只加载 RAG_RERANK_MODEL 指向的本地模型，
# 不会在桌面问答时静默下载。colbert 当前是实验性 hash MaxSim provider。
RAG_P2_ENABLED=true
RAG_RERANK_PROVIDER=lexical
RAG_RERANK_MODEL=
RAG_RERANK_CANDIDATES=30
RAG_RERANK_TOP_N=12
RAG_RERANK_API_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT_SECONDS=20
RAG_RELEVANCE_THRESHOLD=0.0
RAG_CONTEXT_EXPANSION_ENABLED=true
RAG_EVIDENCE_MAX_TOKENS=900
RAG_FINAL_TOP_K=6
RAG_MMR_LAMBDA=0.72
# 高可靠模式额外调用一次 LLM 审核“结论是否被引用证据支持”，普通问答默认关闭。
RAG_CITATION_SUPPORT_ENABLED=false
